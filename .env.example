# Server Port (Cloud Run sets PORT automatically, default 3000)
PORT=3000

# Runtime Environment
NODE_ENV=production

# Public Application URL (populated automatically by Cloud Run / AI Studio)
APP_URL="https://your-service-url.run.app"

# Server-side HMAC secret for OTP challenge tokens (set a strong random string in Cloud Run)
OTP_SECRET="replace-with-a-random-32-byte-secret"

# Optional Gemini API Key (if AI features are added later; keep server-side only)
GEMINI_API_KEY=""
